PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-lost-found?appName=Cluster0
JWT_SECRET=generate_with__openssl_rand_-hex_48
COLLEGE_EMAIL_DOMAINS=nsut.ac.in,nsit.net.in
# Set to true to only allow COLLEGE_EMAIL_DOMAINS to register (currently off)
ENFORCE_COLLEGE_EMAIL=false

# Optional: only needed if you want real email notifications.
# Leave blank to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Lost & Found <no-reply@nsut.ac.in>"

# Set to true if the backend runs behind a reverse proxy (nginx, Render, etc.)
# so rate limiting sees each user's real IP instead of the proxy's.
TRUST_PROXY=false
